extends "res://tests/headless/test_case.gd"


func run() -> Dictionary:
	var root := Node2D.new()
	attach_test_node(root)
	var agent := NucleusTargetingAgent.new()
	agent.automatic_refresh = false
	root.add_child(agent)
	var first_sensor := RefCounted.new()
	var second_sensor := RefCounted.new()
	var target := NucleusTargetable.new()
	root.add_child(target)
	agent.register_candidate(target, first_sensor)
	agent.register_candidate(target, second_sensor)
	agent.unregister_candidate(target, first_sensor)
	expect_true(agent.has_candidate(target), "Other sensor retains ownership.")
	agent.refresh_selection()
	expect_equal(agent.lock_current(), OK, "Live target can be locked.")
	var removed: Array[int] = []
	agent.candidate_removed.connect(func(value: NucleusTargetable) -> void:
		removed.append(value.get_instance_id()))
	root.remove_child(target)
	expect_equal(removed.size(), 1, "Exit reports one valid removal for all sensors.")
	expect_true(agent.current == null, "Exit clears selection before free.")
	expect_false(agent.is_locked(), "Exit clears lock.")
	root.add_child(target)
	expect_false(agent.has_candidate(target), "Re-entry needs explicit sensor registration.")
	agent.register_candidate(target)
	agent.refresh_selection()
	target.free()
	expect_equal(agent.get_candidates().size(), 0, "Free removes endpoint safely.")
	var detached := NucleusTargetable.new()
	detached.target = root
	agent.register_candidate(detached)
	agent.refresh_selection()
	detached.free()
	agent.refresh_selection()
	expect_true(agent.current == null, "Freed detached endpoint is pruned safely.")
	expect_equal(agent.get_cached_ranked_candidates().size(), 0, "Cache drops freed entries.")
	agent.clear_candidates()
	expect_equal(agent.get_candidates().size(), 0, "Clear tolerates freed endpoints.")
	var survivor := NucleusTargetable.new()
	root.add_child(survivor)
	agent.register_candidate(survivor)
	root.remove_child(agent)
	root.add_child(agent)
	survivor.free()
	expect_equal(agent.get_candidates().size(), 0, "Agent re-entry reconnects cleanup.")
	var final_target := NucleusTargetable.new()
	root.add_child(final_target)
	agent.register_candidate(final_target)
	agent.free()
	final_target.notify_metadata_changed()
	final_target.free()
	free_test_node(root)
	return finish()

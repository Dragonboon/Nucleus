class_name NucleusSplineRoad3D
extends Node3D
## Optional scene-owned bridge: Path3D -> road mesh -> existing surface sampler.
## Explicit rebuilds; never changes control points, terrain or navigation.

signal mesh_built(sections: int, length: float)
signal build_failed(error: Error)

@export var path: Path3D
@export var target_mesh: MeshInstance3D
@export var surface_sampler: NucleusSurfaceSampler3D
@export var profile: NucleusSplinePathProfile3D
@export var auto_build_on_ready: bool = true

var _generated_mesh: ArrayMesh


func _ready() -> void:
	if auto_build_on_ready:
		rebuild()


## On failure the previous visible mesh is retained.
func rebuild() -> Error:
	if (
		path == null or not is_instance_valid(path)
		or target_mesh == null or not is_instance_valid(target_mesh)
		or profile == null or path.curve == null
	):
		build_failed.emit(ERR_UNCONFIGURED)
		return ERR_UNCONFIGURED
	if not is_inside_tree() or not path.is_inside_tree() or not target_mesh.is_inside_tree():
		build_failed.emit(ERR_UNAVAILABLE)
		return ERR_UNAVAILABLE
	var built: Dictionary = NucleusSplinePathMeshBuilder3D.build(
		path.curve, profile, path.global_transform,
		target_mesh.global_transform, surface_sampler
	)
	var error: Error = built.get("error", ERR_INVALID_DATA)
	if error != OK:
		build_failed.emit(error)
		return error
	_generated_mesh = built["mesh"]
	target_mesh.mesh = _generated_mesh
	mesh_built.emit(int(built["sections"]), float(built["length"]))
	return OK


## Remove only geometry generated by this component, not authored Mesh Resources.
func clear_generated() -> void:
	if is_instance_valid(target_mesh) and target_mesh.mesh == _generated_mesh:
		target_mesh.mesh = null
	_generated_mesh = null

[gd_resource type="Resource" script_class="NucleusFloatSettingDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/nucleus/core/settings/definitions/float_setting_definition.gd" id="1_definition"]

[resource]
script = ExtResource("1_definition")
section = &"input"
key = &"gamepad_move_deadzone"
display_name = "Controller Movement Deadzone"
description = "Sets the default radial deadzone for controller movement when a scene does not override it."

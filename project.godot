; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nucleus"
config/auto_accept_quit=false
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

NucleusApp="*res://core/application/application.gd"
NucleusSettings="*res://core/settings/settings.tscn"
NucleusInput="*res://core/input/input_service.gd"
NucleusAudio="*res://core/audio/audio.tscn"
NucleusSave="*res://core/save/save.tscn"
NucleusSceneFlow="*res://core/scene_flow/scene_flow_service.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://components/": "yellow",
"res://components/ui/": "green",
"res://core/": "purple",
"res://modules/": "purple"
}

[gui]

theme/custom="res://components/ui/theme/nucleus_base_theme.tres"

